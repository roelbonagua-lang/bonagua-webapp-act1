rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 128
        && (data.role == 'freelancer' || data.role == 'client')
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidVaultFile(data) {
      return data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.size is number && data.size >= 0
        && data.sizeFormatted is string && data.sizeFormatted.size() <= 32
        && data.type is string && data.type.size() <= 128
        && (data.category == 'document' || data.category == 'image' || data.category == 'design' || data.category == 'archive' || data.category == 'other')
        && (data.status == 'draft' || data.status == 'in_review' || data.status == 'approved' || data.status == 'delivered')
        && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 128))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('dataUrl' in data) || (data.dataUrl is string && data.dataUrl.size() <= 800000))
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if false;

      match /files/{fileId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(fileId) && isValidVaultFile(request.resource.data);
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(fileId) && isValidVaultFile(request.resource.data);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(fileId);
      }
    }
  }
}
