{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile information in WelVault",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier of the user matching request.auth.uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User full name or agency name",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "User role (freelancer or client)",
          "enum": ["freelancer", "client"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user account was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user account was last updated"
        }
      },
      "required": ["id", "email", "displayName", "role", "createdAt"]
    },
    "VaultFile": {
      "title": "VaultFile",
      "description": "Metadata and contents of a client file uploaded to WelVault",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique file ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "UID of the owner user who uploaded and manages the file",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Original file name",
          "maxLength": 256
        },
        "size": {
          "type": "number",
          "description": "Size in bytes"
        },
        "sizeFormatted": {
          "type": "string",
          "description": "Human readable size (e.g. 2.4 MB)",
          "maxLength": 32
        },
        "type": {
          "type": "string",
          "description": "MIME type of the file",
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "description": "File classification",
          "enum": ["document", "image", "design", "archive", "other"]
        },
        "status": {
          "type": "string",
          "description": "Client review or delivery status",
          "enum": ["draft", "in_review", "approved", "delivered"]
        },
        "clientName": {
          "type": "string",
          "description": "Client or project association name",
          "maxLength": 128
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or instructions for the client",
          "maxLength": 1000
        },
        "dataUrl": {
          "type": "string",
          "description": "File data URL or storage representation for downloads and previews",
          "maxLength": 800000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the file was uploaded"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the file was last modified"
        }
      },
      "required": ["id", "userId", "name", "size", "sizeFormatted", "type", "category", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile and account information"
    },
    "/users/{userId}/files/{fileId}": {
      "schema": "VaultFile",
      "description": "Stores uploaded client files and metadata owned exclusively by the user"
    }
  }
}
